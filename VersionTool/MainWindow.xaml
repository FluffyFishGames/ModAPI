<Window x:Class="MODAPI_VersionTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModAPI Version Update Tool"
        Width="460" Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ModAPI Version Update Tool"
                   FontSize="20" FontWeight="Bold" Foreground="#E0E0E0"/>

        <Border Grid.Row="2" Height="1" Background="#0F3460"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="Current Version: " FontSize="13" Foreground="#888888"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="CurrentVersionText" FontSize="13" Foreground="#E94560"
                       FontFamily="Consolas" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="6" Text="New Version (e.g. 2.0.9618)"
                   FontSize="12" Foreground="#888888"/>

        <TextBox Grid.Row="7" x:Name="VersionInput"
                 VerticalAlignment="Top"
                 Background="#16213E" Foreground="#E0E0E0"
                 BorderBrush="#0F3460" BorderThickness="1"
                 FontSize="16" FontFamily="Consolas"
                 MinHeight="40" Padding="8,6"/>

        <Button Grid.Row="8" Content="Apply Version"
                Background="#E94560" Foreground="White"
                FontSize="14" FontWeight="SemiBold"
                BorderThickness="0" Padding="0,10"
                Cursor="Hand"
                Click="Apply_Click"/>
    </Grid>
</Window>
