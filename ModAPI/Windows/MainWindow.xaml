<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Components="clr-namespace:ModAPI.Components" 
        xmlns:ComponentsInputs="clr-namespace:ModAPI.Components.Inputs" 
        xmlns:local="clr-namespace:ModAPI" x:Class="ModAPI.MainWindow"
        SnapsToDevicePixels="True"
        Style="{StaticResource Window}"
        Background="{DynamicResource FluentBgBrush}"
        MinWidth="800"
        MinHeight="500"
        Height="650"
        Title="ModAPI v2.0" Loaded="WindowLoaded" ContentRendered="Window_ContentRendered" SizeChanged="Window_SizeChanged" LayoutUpdated="Window_LayoutUpdated" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp" Activated="Window_Activated" Closed="Window_Closed" WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="Transparent" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Background Texture Layers (behind all content) -->
        <!-- ============================================================ -->
        <Image x:Name="TextureLayer1" Grid.RowSpan="2" Stretch="UniformToFill"
               Opacity="0.13" Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- ============================================================ -->
        <!-- Main Tab Control -->
        <!-- ============================================================ -->
        <Components:TabControlEx x:Name="Tabs" Grid.Row="0" SnapsToDevicePixels="True" 
                                 Style="{StaticResource TopTabs}" SelectionChanged="Tabs_SelectionChanged">
            <Components:TabControlEx.Items>

                 <!-- ======================================== -->
                 <!-- TAB: Welcome -->
                 <!-- ======================================== -->
                 <Components:IconTabItem SnapsToDevicePixels="True"
                     Label="{DynamicResource Lang.Welcome.Tab}"
                     IconSource="/resources/textures/Icons/IconTop_Informations.png"
                     SelectedIconSource="/resources/textures/Icons/IconTop_Informations_Selected.png"
                     Style="{StaticResource TopTab}">
                     <Grid Margin="16">
                         <Components:PopupPanel Title="{DynamicResource Lang.Welcome.Tab}">
                             <ContentControl Style="{StaticResource PanelCenter}">
                                 <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                                     <StackPanel Orientation="Vertical">
                                         <TextBlock Style="{StaticResource HeaderLabel}" Text="{DynamicResource Lang.Mods.Welcome.Title0}" />
                                         <TextBlock TextWrapping="Wrap" Style="{StaticResource NormalLabel}" Margin="0,8,0,0" Text="{DynamicResource Lang.Mods.Welcome.Text0}" />
                                         <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource NormalLabel}" Text="{DynamicResource Lang.Mods.Welcome.Text1}" />
                                         <TextBlock Margin="0,16,0,0" Style="{StaticResource HeaderLabel}" Text="{DynamicResource Lang.Mods.Welcome.Title1}" />
                                         <TextBlock TextWrapping="Wrap" Style="{StaticResource NormalLabel}" Margin="0,8,0,0">
                                             <TextBlock Text="{DynamicResource Lang.Mods.Welcome.Text2a}" /><Hyperlink x:Name="ModApiLink" NavigateUri="https://modapi.survivetheforest.net" RequestNavigate="Hyperlink_RequestNavigate"
                                                        Foreground="{DynamicResource FluentLinkBrush}" TextDecorations="None"><TextBlock Text="{DynamicResource Lang.Mods.Welcome.Text2Link}" /></Hyperlink><TextBlock Text="{DynamicResource Lang.Mods.Welcome.Text2b}" />
                                         </TextBlock>
                                         <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource NormalLabel}" Text="{DynamicResource Lang.Mods.Welcome.Text3}" />
                                     </StackPanel>
                                 </ScrollViewer>
                             </ContentControl>
                         </Components:PopupPanel>
                     </Grid>
                 </Components:IconTabItem>


                <!-- ======================================== -->
                <!-- TAB: Mods -->
                <!-- ======================================== -->
                <Components:IconTabItem SnapsToDevicePixels="True" 
                    Label="{DynamicResource Lang.Mods.Tab}" 
                    IconSource="/resources/textures/Icons/IconTop_Mods.png" 
                    SelectedIconSource="/resources/textures/Icons/IconTop_Mods_Selected.png" 
                    Style="{StaticResource TopTab}">

                     <Grid Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                         <Components:PopupPanel Title="{DynamicResource Lang.Mods.Title}">
                             <Grid>
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="*" />
                                     <RowDefinition Height="Auto" />
                                 </Grid.RowDefinitions>
                                 <ContentControl Style="{StaticResource PanelCenter}" Grid.Row="0">
                                     <Grid Margin="10,7,10,10" x:Name="ModsPanel">
                                         <Grid.ColumnDefinitions>
                                             <!-- Col 0: Game Filter (Auto) -->
                                             <ColumnDefinition Width="Auto" />
                                             <!-- Col 1: Mod List (Auto — 모드명 길이에 따라 자동) -->
                                             <ColumnDefinition Width="Auto" />
                                             <!-- Col 2: Information/Settings (* — 나머지 공간) -->
                                             <ColumnDefinition Width="*" />
                                         </Grid.ColumnDefinitions>
                                         <!-- Col 0: Game Filter -->
                                         <StackPanel Grid.Column="0"
                                                     Orientation="Vertical" Margin="0,0,8,0">
                                             <StackPanel x:Name="ModGameFilterPanel"
                                                         Orientation="Vertical" />
                                         </StackPanel>
                                         <!-- Col 1: Mod List + Delete Button -->
                                         <Grid Grid.Column="1" Margin="0,0,8,0">
                                             <Grid.RowDefinitions>
                                                 <RowDefinition Height="*" />
                                                 <RowDefinition Height="Auto" />
                                             </Grid.RowDefinitions>
                                             <ListBox x:Name="ModListBox" Grid.Row="0"
                                                      ItemsSource="{Binding FilteredMods}"
                                                      SelectedItem="{Binding SelectedModItem, Mode=TwoWay}"
                                                      SelectionMode="Single" Style="{StaticResource List}"
                                                      HorizontalAlignment="Left" MinWidth="150" MaxWidth="500" VerticalAlignment="Stretch"
                                                      HorizontalContentAlignment="Stretch"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                             <Button Grid.Row="1" x:Name="DeleteModButton"
                                                     Width="{Binding ActualWidth, ElementName=ModListBox}"
                                                     HorizontalAlignment="Left" Margin="0,5,0,0"
                                                     Click="DeleteMod_Click" Style="{StaticResource NormalButton}"
                                                     HorizontalContentAlignment="Center"
                                                     IsEnabled="False">
                                                 <TextBlock Style="{StaticResource NormalLabel}" Text="{DynamicResource Lang.Mods.Buttons.Delete}"
                                                            HorizontalAlignment="Center" TextAlignment="Center" />
                                             </Button>
                                         </Grid>
                                         <Grid Grid.Column="2" x:Name="NoModSelected" Margin="16,0,0,10" />
                                        <Grid Grid.Column="2" x:Name="SelectedMod" Margin="0,0,0,0" Visibility="Collapsed">
                                            <Components:TabControlEx Grid.Column="1" Grid.Row="0" Margin="16,0,0,0" 
                                                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                                                     Style="{StaticResource PopupTabs}">
                                                <!-- Mod Info Tab -->
                                                <Components:IconTabItem SnapsToDevicePixels="True" 
                                                    Label="{DynamicResource Lang.Mods.Tabs.Informations}" 
                                                    IconSource="/resources/textures/Icons/IconTop_Informations.png" 
                                                    SelectedIconSource="/resources/textures/Icons/IconTop_Informations_Selected.png" 
                                                    Style="{StaticResource PopupTab}">
                                                    <ContentControl Style="{StaticResource TabBox}">
                                                        <Grid Margin="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                     <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Margin="0,0,0,5" Style="{StaticResource HeaderLabel}" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding Name}" TextWrapping="Wrap" />
                                                                <TextBlock Margin="0,0,0,5" Style="{StaticResource NormalLabel}" Grid.Column="0" Grid.Row="1" Text="{DynamicResource Lang.Mods.Labels.Version}" />
                                                                <TextBlock Margin="10,0,0,5" TextWrapping="Wrap" Style="{StaticResource NormalLabel}" Grid.Column="1" Grid.Row="1" Text="{Binding Version}" />
                                                                <TextBlock Margin="0,0,0,5" Style="{StaticResource NormalLabel}" Grid.Column="0" Grid.Row="2" Text="{DynamicResource Lang.Mods.Labels.ID}" />
                                                                <TextBlock Margin="10,0,0,5" TextWrapping="Wrap" Style="{StaticResource NormalLabel}" Grid.Column="1" Grid.Row="2" Text="{Binding Id}" />
                                                                <TextBlock Margin="0,0,0,5" Style="{StaticResource NormalLabel}" Grid.Column="0" Grid.Row="3" Text="{DynamicResource Lang.Mods.Labels.Description}" />
                                                                <TextBlock Margin="10,0,0,5" TextWrapping="Wrap" Style="{StaticResource NormalLabel}" Grid.Column="1" Grid.Row="3" Text="{Binding Description}" />
                                                                <TextBlock Margin="0,0,0,5" Style="{StaticResource NormalLabel}" Grid.Column="0" Grid.Row="4" Text="{DynamicResource Lang.Mods.Labels.Game}" />
                                                                <TextBlock Margin="10,0,0,5" TextWrapping="Wrap" Style="{StaticResource NormalLabel}" Grid.Column="1" Grid.Row="4" Text="{Binding GameName}" />
                                                            </Grid>
                                                            <Grid Grid.Column="1">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>
                                                                <TextBlock Style="{StaticResource HeaderLabel}" Grid.Row="0" Text="{DynamicResource Lang.Mods.Labels.AvailableVersions}" Margin="0,0,0,5" />
                                                                <ListView ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Grid.Row="1" Style="{StaticResource List}" MinWidth="200" />
                                                            </Grid>
                                                        </Grid>
                                                    </ContentControl>
                                                </Components:IconTabItem>
                                                <!-- Mod Settings Tab -->
                                                <Components:IconTabItem SnapsToDevicePixels="True" 
                                                    Label="{DynamicResource Lang.Mods.Tabs.Settings}" 
                                                    IconSource="/resources/textures/Icons/IconTab_Settings.png" 
                                                    SelectedIconSource="/resources/textures/Icons/IconTab_Settings_Selected.png" 
                                                    Style="{StaticResource PopupTab}">
                                                    <ContentControl Style="{StaticResource TabBox}">
                                                        <Grid Margin="12">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                            </Grid.RowDefinitions>
                                                            <TextBlock Grid.Row="0" Text="{DynamicResource Lang.Mods.Labels.Buttons}" Style="{StaticResource HeaderLabel}" />
                                                            <ScrollViewer Grid.IsSharedSizeScope="True" Grid.Row="1" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto">
                                                                <ItemsControl ItemsSource="{Binding Buttons}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel IsItemsHost="True" Orientation="Vertical" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </ScrollViewer>
                                                        </Grid>
                                                    </ContentControl>
                                                </Components:IconTabItem>
                                            </Components:TabControlEx>
                                        </Grid>
                                    </Grid>
                                </ContentControl>
                                <!-- Mods Action Bar -->
                                <ContentControl Grid.Row="1" Style="{StaticResource PanelButtons}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Margin="5" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Click="StartGame">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="{DynamicResource Lang.Mods.Buttons.StartGame}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ContentControl>
                            </Grid>
                        </Components:PopupPanel>
                     </Grid>
                 </Components:IconTabItem>

                <!-- ======================================== -->
                <!-- TAB: Downloads -->
                <!-- ======================================== -->
                <Components:IconTabItem SnapsToDevicePixels="True" 
                    Label="{DynamicResource Lang.Downloads.Tab}" 
                    IconSource="/resources/textures/Icons/Icon_Download.png" 
                    SelectedIconSource="/resources/textures/Icons/Icon_Download.png" 
                    Style="{StaticResource TopTab}">

                    <Grid Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Components:PopupPanel Title="{DynamicResource Lang.Downloads.Title}">
                            <Grid>
                                <!-- Online Content -->
                                <Grid x:Name="DownloadOnlinePanel" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Bar: Search + Refresh -->
                                    <ContentControl Style="{StaticResource PanelButtons}" Grid.Row="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                                <TextBox x:Name="DownloadSearchBox" 
                                                         VerticalAlignment="Center"
                                                         Text="" TextChanged="DownloadSearch_TextChanged" />
                                                <TextBlock x:Name="DownloadSearchPlaceholder"
                                                           Text="{DynamicResource Lang.Downloads.Search.Placeholder}"
                                                           Style="{StaticResource NormalLabel}"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                           Opacity="0.4" IsHitTestVisible="False" />
                                            </Grid>
                                            <Button x:Name="DownloadRefreshButton" Grid.Column="1" 
                                                    Style="{StaticResource NormalButton}" Click="DownloadRefresh_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{DynamicResource Lang.Downloads.Buttons.Refresh}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </ContentControl>

                                    <!-- Game Filter Radio Buttons (1st filter) -->
                                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="4,2,4,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource Lang.Downloads.Label.GameFilter}"
                                                       Style="{StaticResource NormalLabel}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="2,0,8,0" />
                                            <WrapPanel x:Name="GameFilterPanel" Orientation="Horizontal">
                                            <RadioButton x:Name="GameAll" Content="{DynamicResource Lang.Downloads.Game.All}" 
                                                         GroupName="GameFilter" IsChecked="True" Checked="GameFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="GameTheForest" Content="{DynamicResource Lang.Downloads.Game.TheForest}" 
                                                         GroupName="GameFilter" Checked="GameFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="GameDedicatedServer" Content="{DynamicResource Lang.Downloads.Game.DedicatedServer}" 
                                                         GroupName="GameFilter" Checked="GameFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="GameVR" Content="{DynamicResource Lang.Downloads.Game.VR}" 
                                                         GroupName="GameFilter" Checked="GameFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="GameSubnautica" Content="{DynamicResource Lang.Downloads.Game.Subnautica}" 
                                                         GroupName="GameFilter" Checked="GameFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="GameRaft" Content="{DynamicResource Lang.Downloads.Game.Raft}" 
                                                         GroupName="GameFilter" Checked="GameFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="GameEscapeThePacific" Content="{DynamicResource Lang.Downloads.Game.EscapeThePacific}" 
                                                         GroupName="GameFilter" Checked="GameFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="GameGreenHell" Content="{DynamicResource Lang.Downloads.Game.GreenHell}" 
                                                         GroupName="GameFilter" Checked="GameFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="GameSOTF" Content="{DynamicResource Lang.Downloads.Game.SOTF}" 
                                                         GroupName="GameFilter" Checked="GameFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Category Filter Radio Buttons (2nd filter) -->
                                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="4,2,4,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource Lang.Downloads.Label.ModSelect}"
                                                       Style="{StaticResource NormalLabel}" FontSize="12"
                                                       VerticalAlignment="Center" Margin="2,0,8,0" />
                                            <WrapPanel x:Name="CategoryFilterPanel" Orientation="Horizontal">
                                            <RadioButton x:Name="CatAll" Content="{DynamicResource Lang.Downloads.Category.All}" 
                                                         GroupName="CategoryFilter" IsChecked="True" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="CatBugfixes" Content="{DynamicResource Lang.Downloads.Category.Bugfixes}" 
                                                         GroupName="CategoryFilter" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="CatBalancing" Content="{DynamicResource Lang.Downloads.Category.Balancing}" 
                                                         GroupName="CategoryFilter" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="CatCheats" Content="{DynamicResource Lang.Downloads.Category.Cheats}" 
                                                         GroupName="CategoryFilter" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="CatBuildings" Content="{DynamicResource Lang.Downloads.Category.Buildings}" 
                                                         GroupName="CategoryFilter" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="CatGraphical" Content="{DynamicResource Lang.Downloads.Category.Graphical}" 
                                                         GroupName="CategoryFilter" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="CatChanges" Content="{DynamicResource Lang.Downloads.Category.Changes}" 
                                                         GroupName="CategoryFilter" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="CatItems" Content="{DynamicResource Lang.Downloads.Category.Items}" 
                                                         GroupName="CategoryFilter" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="CatEnemies" Content="{DynamicResource Lang.Downloads.Category.Enemies}" 
                                                         GroupName="CategoryFilter" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="CatMultiplayer" Content="{DynamicResource Lang.Downloads.Category.Multiplayer}" 
                                                         GroupName="CategoryFilter" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="CatWorldchanges" Content="{DynamicResource Lang.Downloads.Category.Worldchanges}" 
                                                         GroupName="CategoryFilter" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            <RadioButton x:Name="CatOther" Content="{DynamicResource Lang.Downloads.Category.Other}" 
                                                         GroupName="CategoryFilter" Checked="CategoryFilter_Checked" Margin="2,2" Foreground="{DynamicResource FluentTextPrimaryBrush}" FontFamily="{StaticResource NormalFont}" FontSize="12" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Split: Left=Mod List, Right=Version List -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Mod List -->
                                        <ContentControl Style="{StaticResource PanelCenter}" Grid.Column="0">
                                            <ListView x:Name="DownloadModList" 
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                      SelectionChanged="DownloadModList_SelectionChanged"
                                                      GridViewColumnHeader.Click="DownloadModList_HeaderClick">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="{DynamicResource Lang.Downloads.Headers.Name}" Width="120" 
                                                                        DisplayMemberBinding="{Binding Name}" />
                                                        <GridViewColumn Header="{DynamicResource Lang.Downloads.Headers.Author}" Width="80" 
                                                                        DisplayMemberBinding="{Binding Author}" />
                                                        <GridViewColumn Header="{DynamicResource Lang.Downloads.Headers.Category}" Width="80" 
                                                                        DisplayMemberBinding="{Binding Category}" />
                                                        <GridViewColumn Header="{DynamicResource Lang.Downloads.Headers.Game}" Width="70" 
                                                                        DisplayMemberBinding="{Binding Game}" />
                                                        <GridViewColumn Header="{DynamicResource Lang.Downloads.Headers.Downloads}" Width="70" 
                                                                        DisplayMemberBinding="{Binding DownloadCount}" />
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </ContentControl>

                                        <!-- Separator -->
                                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

                                        <!-- Right: Version List -->
                                        <Grid Grid.Column="2">
                                            <!-- Empty placeholder when no mod selected -->
                                            <TextBlock x:Name="DownloadVersionPlaceholder"
                                                       Style="{StaticResource NormalLabel}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Text="{DynamicResource Lang.Downloads.Version.Select}" />

                                            <!-- Version panel (shown when mod selected) -->
                                            <Grid x:Name="DownloadVersionPanel" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Version header: Mod name + Info button -->
                                                <ContentControl Style="{StaticResource PanelButtons}" Grid.Row="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="DownloadVersionTitle" Grid.Column="0"
                                                                   Style="{StaticResource HeaderLabel}" 
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Margin="8,0,0,0" />
                                                        <Button x:Name="DownloadInfoButton" Grid.Column="1"
                                                                Style="{StaticResource NormalButton}" Click="DownloadInfo_Click">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                <TextBlock Text="{DynamicResource Lang.Downloads.Buttons.Info}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </ContentControl>

                                                <!-- Version list with radio buttons -->
                                                <ContentControl Style="{StaticResource PanelCenter}" Grid.Row="1">
                                                    <ListView x:Name="DownloadVersionList"
                                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                              SelectionChanged="DownloadVersionList_SelectionChanged">
                                                        <ListView.View>
                                                            <GridView>
                                                                <GridViewColumn Header="{DynamicResource Lang.Downloads.Version.Version}" Width="90" 
                                                                                DisplayMemberBinding="{Binding Version}" />
                                                                <GridViewColumn Header="{DynamicResource Lang.Downloads.Version.Compatible}" Width="70" 
                                                                                DisplayMemberBinding="{Binding Compatible}" />
                                                                <GridViewColumn Header="{DynamicResource Lang.Downloads.Version.Date}" Width="90" 
                                                                                DisplayMemberBinding="{Binding Date}" />
                                                                <GridViewColumn Header="{DynamicResource Lang.Downloads.Version.Size}" Width="60" 
                                                                                DisplayMemberBinding="{Binding Size}" />
                                                            </GridView>
                                                        </ListView.View>
                                                    </ListView>
                                                </ContentControl>
                                            </Grid>
                                        </Grid>
                                    </Grid>

                                    <!-- Bottom Bar: Status + Download Button -->
                                    <ContentControl Grid.Row="4" Style="{StaticResource PanelButtons}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DownloadStatusText" Grid.Column="0" 
                                                       Style="{StaticResource NormalLabel}" VerticalAlignment="Center"
                                                       Padding="8,0,0,0"
                                                       Text="{DynamicResource Lang.Downloads.Status.Ready}" />
                                            <Button x:Name="DownloadButton" Grid.Column="1" IsEnabled="False"
                                                    Style="{StaticResource AccentButton}" Click="DownloadMod_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{DynamicResource Lang.Downloads.Buttons.Download}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </ContentControl>
                                </Grid>

                                <!-- Offline Notice -->
                                <Grid x:Name="DownloadOfflinePanel" Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="48" 
                                               Foreground="{DynamicResource FluentWarningBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,16" />
                                        <TextBlock Style="{StaticResource HeaderLabel}" 
                                                   HorizontalAlignment="Center" Margin="0,0,0,12"
                                                   Text="{DynamicResource Lang.Downloads.Offline.Title}" />
                                        <TextBlock Style="{StaticResource NormalLabel}" TextWrapping="Wrap" 
                                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,8"
                                                   Text="{DynamicResource Lang.Downloads.Offline.Text}" />
                                        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,16">
                                            <Hyperlink NavigateUri="https://modapi.survivetheforest.net/mods/" 
                                                       RequestNavigate="Hyperlink_RequestNavigate"
                                                       Foreground="{DynamicResource FluentLinkBrush}" TextDecorations="None">
                                                <TextBlock Text="modapi.survivetheforest.net/mods/" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource NormalLabel}" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,4,0"
                                                   Text="{DynamicResource Lang.Downloads.Offline.Manual}" />
                                        <TextBlock Style="{StaticResource NormalLabel}" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"
                                                   Text="{DynamicResource Lang.Downloads.Offline.Manual2}" />
                                        <Button Style="{StaticResource NormalButton}" HorizontalAlignment="Center"
                                                Click="DownloadRetryConnection_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="{DynamicResource Lang.Downloads.Offline.Retry}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Components:PopupPanel>
                    </Grid>
                </Components:IconTabItem>

                <!-- ======================================== -->
                <!-- TAB: Development -->
                <!-- ======================================== -->
                <Components:IconTabItem x:Name="Development" SnapsToDevicePixels="True" 
                    Label="{DynamicResource Lang.Development.Tab}" 
                    IconSource="/resources/textures/Icons/IconTab_Debug.png" 
                    SelectedIconSource="/resources/textures/Icons/IconTab_Debug_Selected.png" 
                    Style="{StaticResource TopTab}">

                    <Grid Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <!-- Col 0: Game Filter -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Col 1: Projects List -->
                            <ColumnDefinition Width="Auto" />
                            <!-- Col 2: Selected Project -->
                            <ColumnDefinition Width="*" />
                            <!-- Col 3: Dev Tools -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Col 0: Game Filter -->
                        <Components:PopupPanel Title="{DynamicResource Lang.Development.Labels.GameFilter}" Grid.Column="0" Margin="0,0,8,0">
                            <ContentControl Style="{StaticResource PanelCenter}">
                                <StackPanel x:Name="DevGameFilterPanel" Orientation="Vertical" Margin="10,7,10,10" />
                            </ContentControl>
                        </Components:PopupPanel>

                        <!-- Col 1: Projects List Panel -->
                        <Components:PopupPanel Title="{DynamicResource Lang.Development.Projects}" Grid.Column="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ContentControl Style="{StaticResource PanelCenter}" Grid.Row="0">
                                    <ListBox Margin="10,5,10,10" x:Name="ProjectList" SelectedIndex="{Binding SelectedProject,Mode=TwoWay}"
                                             Style="{StaticResource List}" ItemsSource="{Binding Projects}"
                                             MinWidth="150" MaxWidth="7680" VerticalAlignment="Stretch" />
                                </ContentControl>
                                <ContentControl Height="42" Style="{StaticResource PanelButtons}" Grid.Row="1">
                                    <Button Style="{StaticResource NormalButton}" HorizontalAlignment="Right" Click="CreateProject" Margin="5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="{DynamicResource Lang.Development.Buttons.CreateProject}" />
                                        </StackPanel>
                                    </Button>
                                </ContentControl>
                            </Grid>
                        </Components:PopupPanel>


                        <!-- Selected Project Panel -->
                        <Components:PopupPanel Title="{DynamicResource Lang.Development.SelectedProject}" Grid.Column="2" Margin="12,0,0,0">
                            <Grid Margin="0">
                                <!-- No Project Selected -->
                                <Grid x:Name="NoProjectSelected">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ContentControl Padding="10" Style="{StaticResource PanelCenter}" Grid.Row="0">
                                        <TextBlock Margin="10,5,10,10" Style="{StaticResource HeaderLabel}" Text="{DynamicResource Lang.Development.NoProjectSelected}" />
                                    </ContentControl>
                                    <ContentControl Height="42" Style="{StaticResource PanelButtons}" Grid.Row="1" />
                                </Grid>
                                <!-- Selected Project Content -->
                                <Grid x:Name="SelectedProject" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ContentControl Style="{StaticResource PanelCenter}" Grid.Row="0">
                                        <Components:TabControlEx Margin="10,5,10,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{StaticResource PopupTabs}">
                                            <!-- Settings Tab -->
                                            <Components:IconTabItem ShowWarning="{Binding SettingsError}" SnapsToDevicePixels="True" 
                                                Label="{DynamicResource Lang.Development.Settings.Tab}" 
                                                IconSource="/resources/textures/Icons/IconTab_Settings.png" 
                                                SelectedIconSource="/resources/textures/Icons/IconTab_Settings_Selected.png" 
                                                Style="{StaticResource PopupTab}">
                                                <ContentControl Style="{StaticResource TabBox}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="1*" />
                                                                <ColumnDefinition Width="1*" MaxWidth="500" MinWidth="200" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" MinHeight="34" />
                                                                <RowDefinition Height="Auto" MinHeight="34" />
                                                                <RowDefinition Height="Auto" MinHeight="34" />
                                                                <RowDefinition Height="Auto" MinHeight="34" />
                                                            </Grid.RowDefinitions>
                                                            <Grid Margin="0,2,0,5" VerticalAlignment="Center" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Visibility="{Binding SaveError}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Top" Grid.Column="0" Text="&#xEA39;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource FluentDangerBrush}" />
                                                                <TextBlock Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Top" Style="{StaticResource NormalLabel}" TextWrapping="Wrap" Text="{DynamicResource Lang.Development.Errors.Save}" />
                                                            </Grid>
                                                            <TextBlock Margin="0,5,5,0" VerticalAlignment="Top" Grid.Column="0" Grid.Row="1" Style="{StaticResource NormalLabel}" Text="{DynamicResource Lang.Development.Labels.ID}" />
                                                            <TextBox Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" Text="{Binding Id,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                                            <Grid Margin="10,2,0,5" VerticalAlignment="Center" Grid.Column="2" Grid.Row="1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Top" Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource FluentAccentBrush}" />
                                                                <TextBlock Grid.Column="1" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Top" Style="{StaticResource NormalLabel}" TextWrapping="Wrap" Text="{DynamicResource Lang.Development.Errors.InvalidID}" />
                                                            </Grid>
                                                            <TextBlock Margin="0,5,5,0" VerticalAlignment="Top" Grid.Column="0" Grid.Row="2" Style="{StaticResource NormalLabel}" Text="{DynamicResource Lang.Development.Labels.Version}" />
                                                            <TextBox Grid.Column="1" VerticalAlignment="Top" Grid.Row="2" Text="{Binding Version,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
                                                            <Grid Margin="10,2,0,5" VerticalAlignment="Center" x:Name="Error_InvalidVersion" Visibility="{Binding VersionError}" Grid.Column="2" Grid.Row="2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Top" Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource FluentWarningBrush}" />
                                                                <TextBlock Grid.Column="1" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Top" Style="{StaticResource NormalLabel}" TextWrapping="Wrap" Text="{DynamicResource Lang.Development.Errors.InvalidVersion}" />
                                                            </Grid>
                                                            <TextBlock Margin="0,5,5,0" VerticalAlignment="Top" Grid.Column="0" Grid.Row="3" Style="{StaticResource NormalLabel}" Text="{DynamicResource Lang.Development.Labels.Name}" />
                                                            <ComponentsInputs:MultilingualTextField Languages="{Binding Languages}" Value="{Binding Name}" VerticalAlignment="Top" Grid.Column="1" Grid.Row="3" />
                                                            <Grid Margin="10,2,0,5" VerticalAlignment="Center" x:Name="Error_InvalidName" Visibility="{Binding NameError}" Grid.Column="2" Grid.Row="3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock VerticalAlignment="Top" Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource FluentWarningBrush}" />
                                                                <TextBlock Grid.Column="1" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Top" Style="{StaticResource NormalLabel}" TextWrapping="Wrap" Text="{DynamicResource Lang.Development.Errors.InvalidName}" />
                                                            </Grid>
                                                            <TextBlock Margin="0,5,5,0" VerticalAlignment="Top" Grid.Column="0" Grid.Row="4" Style="{StaticResource NormalLabel}" Text="{DynamicResource Lang.Development.Labels.Description}" />
                                                            <ComponentsInputs:MultilingualTextField VerticalAlignment="Top" Languages="{Binding Languages}" Value="{Binding Description}" Grid.Column="1" Grid.Row="4" />
                                                        </Grid>
                                                    </ScrollViewer>
                                                </ContentControl>
                                            </Components:IconTabItem>
                                            <!-- Keys Tab -->
                                            <Components:IconTabItem ShowWarning="{Binding ButtonsError}" SnapsToDevicePixels="True" 
                                                Label="{DynamicResource Lang.Development.Keys.Tab}" 
                                                IconSource="/resources/textures/Icons/IconTab_Controller.png" 
                                                SelectedIconSource="/resources/textures/Icons/IconTab_Controller_Selected.png" 
                                                Style="{StaticResource PopupTab}">
                                                <ContentControl Style="{StaticResource TabBox}">
                                                    <Grid Margin="10,5,10,10">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <ScrollViewer BorderBrush="Transparent" BorderThickness="0" Style="{StaticResource ListScrollViewer}">
                                                            <ItemsControl ItemsSource="{Binding Buttons}" Grid.Row="0" Grid.ColumnSpan="2">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel IsItemsHost="True" Orientation="Vertical" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right">
                                                            <Button Style="{StaticResource NormalButton}" HorizontalAlignment="Stretch" Click="AddModProjectButton">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{DynamicResource Lang.Development.Buttons.AddButton}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </ContentControl>
                                            </Components:IconTabItem>
                                            <!-- Languages Tab -->
                                            <Components:IconTabItem ShowWarning="{Binding LanguagesError}" SnapsToDevicePixels="True" 
                                                Label="{DynamicResource Lang.Development.Languages.Tab}" 
                                                IconSource="/resources/textures/Icons/IconTab_Language.png" 
                                                SelectedIconSource="/resources/textures/Icons/IconTab_Language_Selected.png" 
                                                Style="{StaticResource PopupTab}">
                                                <ContentControl Style="{StaticResource TabBox}">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Margin="0,0,0,5" Style="{StaticResource HeaderLabel}" Grid.Row="0" Grid.ColumnSpan="2" Text="{DynamicResource Lang.Development.Languages.SelectedLanguages}" />
                                                            <ItemsControl ItemsSource="{Binding LanguageButtons}" Grid.Row="1" Grid.ColumnSpan="2">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel IsItemsHost="True" Margin="0,0,0,10" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                            <Grid Margin="0,0,0,5" Grid.Row="1" Grid.ColumnSpan="2" x:Name="NoLanguageSelected" Visibility="{Binding LanguagesError}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Margin="0,0,5,0" VerticalAlignment="Center" Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource FluentWarningBrush}" />
                                                                <TextBlock VerticalAlignment="Center" Grid.Column="1" Text="{DynamicResource Lang.Development.Errors.NoLanguageSelected}" Style="{StaticResource NormalLabel}" />
                                                            </Grid>
                                                            <TextBlock Margin="0,0,0,5" Style="{StaticResource HeaderLabel}" Grid.Row="2" Grid.ColumnSpan="2" Text="{DynamicResource Lang.Development.Languages.AddLanguage}" />
                                                            <ComboBox x:Name="DevelopmentLanguageSelector" Grid.Row="3" Grid.Column="0" Margin="0,0,10,0" 
                                                                      Components:ComboBoxWidthFromItemsBehavior.ComboBoxWidthFromItems="True" 
                                                                      Style="{StaticResource ComboBox}" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                            <Button Grid.Row="3" HorizontalAlignment="Left" Grid.Column="1" Style="{StaticResource NormalButton}" Click="AddProjectLanguage">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Lang.Development.Languages.Buttons.AddLanguage}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </ScrollViewer>
                                                </ContentControl>
                                            </Components:IconTabItem>
                                        </Components:TabControlEx>
                                    </ContentControl>
                                    <!-- Project Action Bar -->
                                    <ContentControl Height="42" Style="{StaticResource PanelButtons}" Grid.Row="1">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Margin="5" Style="{StaticResource NormalButton}" Click="RemoveModProjectButton">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{DynamicResource Lang.Development.Buttons.RemoveProject}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Margin="5" Style="{StaticResource AccentButton}" Click="CreateMod">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                    <TextBlock Text="{DynamicResource Lang.Development.Buttons.CreateMod}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </ContentControl>
                                </Grid>
                            </Grid>
                        </Components:PopupPanel>

                        <!-- Mod Library Panel -->
                        <Components:PopupPanel Title="{DynamicResource Lang.Development.ModLibrary}" Grid.Column="3" Margin="12,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ContentControl Grid.Row="0" Style="{StaticResource PanelCenter}">
                                    <Grid Margin="12,5,12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Margin="0,0,10,5" Style="{StaticResource NormalLabel}" Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="{DynamicResource Lang.Development.ModLibrary.CreationTime}" />
                                        <TextBlock x:Name="ModLibCreationTime" Style="{StaticResource NormalLabel}" Grid.Row="0" Grid.Column="1" Text="1.0.0" />
                                        <TextBlock Margin="0,0,10,5" Style="{StaticResource NormalLabel}" Grid.Row="1" Grid.Column="0" FontWeight="Bold" Text="{DynamicResource Lang.Development.ModLibrary.GameVersion}" />
                                        <TextBlock x:Name="ModLibGameVersion" Style="{StaticResource NormalLabel}" Grid.Row="1" Grid.Column="1" Text="1.0.0" />
                                        <TextBlock Margin="0,0,10,5" Style="{StaticResource NormalLabel}" Grid.Row="2" Grid.Column="0" FontWeight="Bold" Text="{DynamicResource Lang.Development.ModLibrary.ModAPIVersion}" />
                                        <TextBlock x:Name="ModLibModAPIVersion" Style="{StaticResource NormalLabel}" Grid.Row="2" Grid.Column="1" Text="1.0.0" />
                                    </Grid>
                                </ContentControl>
                                <ContentControl Grid.Row="1" Style="{StaticResource PanelButtons}">
                                    <StackPanel Orientation="Vertical">
                                        <Button Margin="5" Style="{StaticResource NormalButton}" HorizontalAlignment="Right" Click="CreateModLibrary">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{DynamicResource Lang.Development.Buttons.CreateModLibrary}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </ContentControl>
                            </Grid>
                        </Components:PopupPanel>
                    </Grid>
                </Components:IconTabItem>

                <!-- ======================================== -->
                <!-- TAB: Themes -->
                <!-- ======================================== -->
                <Components:IconTabItem SnapsToDevicePixels="True"
                    Label="{DynamicResource Lang.Options.Labels.Theme}"
                    IconSource="/resources/textures/Icons/IconTab_Settings.png"
                    SelectedIconSource="/resources/textures/Icons/IconTab_Settings_Selected.png"
                    Style="{StaticResource TopTab}">

                    <Grid Margin="16" VerticalAlignment="Top">
                        <Components:PopupPanel Title="{DynamicResource Lang.Options.Labels.Theme}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: ThemeSelector 카드 -->
                                <ContentControl Grid.Row="0" Style="{StaticResource PanelButtons}">
                                    <Border CornerRadius="6" Padding="16,10"
                                            Background="{DynamicResource FluentCardBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource FluentBorderBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Margin="0,0,0,6" Text="{DynamicResource Lang.Options.Labels.Theme}" Style="{StaticResource NormalLabel}" />
                                                <Grid>
                                                    <ComboBox x:Name="ThemeSelector" Style="{StaticResource ComboBox}" Height="40" MinWidth="200"
                                                              Components:ComboBoxWidthFromItemsBehavior.ComboBoxWidthFromItems="True"
                                                              HorizontalAlignment="Left"
                                                              SelectionChanged="ThemeSelector_SelectionChanged" />
                                                    <!-- 배경텍스처 활성 시 ThemeSelector 잠금 오버레이 -->
                                                    <Border x:Name="ThemeSelectorOverlay"
                                                            Background="#60000000"
                                                            IsHitTestVisible="True"
                                                            Visibility="Collapsed"
                                                            CornerRadius="4" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ContentControl>

                                <!-- Row 1: Background Texture 카드 -->
                                <ContentControl Grid.Row="1" Style="{StaticResource PanelButtons}">
                                    <Border CornerRadius="6" Padding="16,12"
                                            Background="{DynamicResource FluentCardBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource FluentBorderBrush}">
                                        <StackPanel Orientation="Vertical">
                                            <!-- 헤더 + 활성화 토글 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource HeaderLabel}"
                                                           Text="{DynamicResource Lang.Options.Labels.TextureBackground}"
                                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                                <CheckBox x:Name="TextureActiveCheckBox" VerticalAlignment="Center" Margin="0,0,8,0"
                                                          IsEnabled="False"
                                                          Checked="TextureActive_Changed" Unchecked="TextureActive_Changed" />
                                                <TextBlock Text="{DynamicResource Lang.Options.Labels.TextureEnable}"
                                                           Style="{StaticResource NormalLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- Slot -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TexturePathBox" Grid.Column="0" IsReadOnly="True"
                                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Button Grid.Column="1" Style="{StaticResource NormalButton}"
                                                        Click="TextureBrowse_Click" Padding="10,4" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource Lang.Options.Labels.Browse}" Style="{StaticResource NormalLabel}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="TextureClearBtn" Grid.Column="2"
                                                        Style="{StaticResource NormalButton}"
                                                        Click="TextureClear_Click" Padding="10,4"
                                                        IsEnabled="False">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource Lang.Options.Labels.TextureClear}" Style="{StaticResource NormalLabel}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </ContentControl>
                            </Grid>
                        </Components:PopupPanel>
                    </Grid>
                </Components:IconTabItem>

                <!-- ======================================== -->
                <!-- TAB: Options -->
                <!-- ======================================== -->
                <Components:IconTabItem SnapsToDevicePixels="True" 
                    Label="{DynamicResource Lang.Options.Tab}" 
                    IconSource="/resources/textures/Icons/IconTab_Settings.png" 
                    SelectedIconSource="/resources/textures/Icons/IconTab_Settings_Selected.png" 
                    Style="{StaticResource TopTab}">

                    <Grid Margin="16" VerticalAlignment="Top">
                        <Components:PopupPanel Title="{DynamicResource Lang.Options.Tab}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: 언어 + 폰트 + 너비 카드 -->
                                <ContentControl Grid.Row="0" Style="{StaticResource PanelButtons}">
                                    <Border CornerRadius="6" Padding="16,10"
                                            Background="{DynamicResource FluentCardBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource FluentBorderBrush}">
                                        <StackPanel x:Name="Settings" Orientation="Horizontal">
                                             <StackPanel Orientation="Vertical" Margin="0,0,32,0">
                                                 <TextBlock Margin="0,0,0,6" Text="{DynamicResource Lang.Options.Labels.Language}" Style="{StaticResource NormalLabel}" />
                                                 <ComboBox SelectedIndex="{Binding Language,Mode=TwoWay}"
                                                           Components:ComboBoxWidthFromItemsBehavior.ComboBoxWidthFromItems="True"
                                                           x:Name="LanguageSelector" Style="{StaticResource ComboBox}" Height="40" MinWidth="200"
                                                           HorizontalAlignment="Left" />
                                             </StackPanel>
                                             <StackPanel Orientation="Vertical" Margin="0,0,32,0">
                                                 <TextBlock Margin="0,0,0,6" Text="{DynamicResource Lang.Options.Labels.FontSize}" Style="{StaticResource NormalLabel}" />
                                                 <ComboBox x:Name="FontSizeSelector" Style="{StaticResource ComboBox}" Height="40" MinWidth="120"
                                                           HorizontalAlignment="Left"
                                                           SelectionChanged="FontSizeSelector_Changed" />
                                             </StackPanel>
                                             <StackPanel Orientation="Vertical" Margin="32,0,0,0" VerticalAlignment="Center">
                                                 <TextBlock Text="{DynamicResource Lang.Options.Labels.MaxWidth}" Style="{StaticResource NormalLabel}"
                                                            Foreground="{DynamicResource FluentTextSecondaryBrush}" />
                                                 <TextBlock x:Name="MaxWidthLabel" Style="{StaticResource NormalLabel}"
                                                            Foreground="{DynamicResource FluentTextSecondaryBrush}" FontSize="18" />
                                             </StackPanel>
                                            <StackPanel Orientation="Vertical" Margin="32,0,0,0">
                                                 <TextBlock Margin="0,0,0,6" Text="{DynamicResource Lang.Options.Labels.ModListWidth}" Style="{StaticResource NormalLabel}" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Slider x:Name="ModListWidthSlider" Minimum="150" Maximum="7680" Width="160" Height="40"
                                                            VerticalAlignment="Center"
                                                            ValueChanged="ModListWidthSlider_Changed" />
                                                    <TextBox x:Name="ModListWidthBox" Width="48" Height="32" Margin="8,0,0,0"
                                                             VerticalAlignment="Center" MaxLength="4"
                                                             TextChanged="ModListWidthBox_Changed" />
                                                    <TextBlock Text="/ " Style="{StaticResource NormalLabel}" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.5" />
                                                    <TextBlock x:Name="ModListWidthMax" Text="500" Style="{StaticResource NormalLabel}" VerticalAlignment="Center" Opacity="0.5" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Orientation="Vertical" Margin="32,0,0,0">
                                                <TextBlock Margin="0,0,0,6" Text="{DynamicResource Lang.Options.Labels.ProjectListWidth}" Style="{StaticResource NormalLabel}" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Slider x:Name="ProjectListWidthSlider" Minimum="150" Maximum="7680" Width="160" Height="40"
                                                            VerticalAlignment="Center"
                                                            ValueChanged="ProjectListWidthSlider_Changed" />
                                                    <TextBox x:Name="ProjectListWidthBox" Width="48" Height="32" Margin="8,0,0,0"
                                                             VerticalAlignment="Center" MaxLength="4"
                                                             TextChanged="ProjectListWidthBox_Changed" />
                                                    <TextBlock Text="/ " Style="{StaticResource NormalLabel}" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.5" />
                                                    <TextBlock x:Name="ProjectListWidthMax" Text="500  " Style="{StaticResource NormalLabel}" VerticalAlignment="Center" Opacity="0.5" Margin="0,0,32,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </ContentControl>

                                <!-- Row 1: 체크박스 3개 카드 -->
                                <ContentControl Grid.Row="1" Style="{StaticResource PanelButtons}">
                                    <Border CornerRadius="6" Padding="16,10"
                                            Background="{DynamicResource FluentCardBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource FluentBorderBrush}">
                                        <WrapPanel x:Name="SettingsCheckboxes" Orientation="Horizontal">
                                            <StackPanel Orientation="Horizontal" Margin="0,4,32,4" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding UpdateVersionsTable,Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{DynamicResource Lang.Options.Labels.UpdateVersionsTable}" Style="{StaticResource NormalLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,32,4" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding AutoUpdate,Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{DynamicResource Lang.Options.Labels.AutoUpdate}" Style="{StaticResource NormalLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,32,4" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding UseSteam,Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{DynamicResource Lang.Options.Labels.UseSteam}" Style="{StaticResource NormalLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- 개발자 로그 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,4,32,4" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding DevLog,Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{DynamicResource Lang.Options.Labels.DevLog}" Style="{StaticResource NormalLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- 로그 초기화 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,4,32,4" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding ClearLogsOnStart,Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{DynamicResource Lang.Options.Labels.ClearLogsOnStart}" Style="{StaticResource NormalLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- 항상 위에 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4" VerticalAlignment="Center">
                                                <CheckBox x:Name="AlwaysOnTopCheckBox" VerticalAlignment="Center" Margin="0,0,8,0"
                                                          Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed" />
                                                <TextBlock Text="{DynamicResource Lang.Options.Labels.AlwaysOnTop}" Style="{StaticResource NormalLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </Border>
                                </ContentControl>

                                <!-- Row 2: 스팀 경로 + 게임 설치 경로 -->
                                <ContentControl Grid.Row="2" Style="{StaticResource PanelButtons}">
                                     <Grid Margin="10,7,10,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <!-- 스팀 설치 경로 -->
                                        <TextBlock Grid.Row="0" Style="{StaticResource HeaderLabel}"
                                                   Text="{DynamicResource Lang.Options.Labels.SteamPath}"
                                                   Margin="0,0,0,6" />
                                        <Grid Grid.Row="1" Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="SteamPathBox" Grid.Column="0"
                                                     VerticalAlignment="Center" IsReadOnly="True"
                                                     Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Style="{StaticResource NormalButton}"
                                                    Click="SteamBrowse_Click" Padding="10,4" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{DynamicResource Lang.Options.Labels.Browse}" Style="{StaticResource NormalLabel}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource NormalButton}"
                                                    Click="SteamSave_Click" Padding="10,4" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{DynamicResource Lang.Options.Labels.GamePathSave}" Style="{StaticResource NormalLabel}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource NormalButton}"
                                                    Click="SteamReset_Click" Padding="10,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{DynamicResource Lang.Options.Labels.PathReset}" Style="{StaticResource NormalLabel}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <!-- 게임 설치 경로 -->
                                        <Grid Grid.Row="2" Margin="0,0,0,8">
                                            <TextBlock Style="{StaticResource HeaderLabel}"
                                                       Text="{DynamicResource Lang.Options.Labels.GamePaths}"
                                                       VerticalAlignment="Center" />
                                            <Button x:Name="ExpandAllBtn" HorizontalAlignment="Right"
                                                    Style="{StaticResource NormalButton}"
                                                    Click="ExpandAll_Click" Padding="10,4">
                                                <TextBlock Text="{DynamicResource Lang.Options.Labels.ExpandAll}"
                                                           Style="{StaticResource NormalLabel}" />
                                            </Button>
                                        </Grid>
                                        <StackPanel x:Name="GamePathsPanel" Grid.Row="3" Orientation="Vertical" />
                                    </Grid>
                                </ContentControl>
                            </Grid>
                        </Components:PopupPanel>
                    </Grid>
                 </Components:IconTabItem>

            </Components:TabControlEx.Items>
        </Components:TabControlEx>

        <!-- ============================================================ -->
        <!-- Title Bar Drag Area + Caption Buttons (overlay on Tab strip) -->
        <!-- ============================================================ -->
        <!-- Mover: hidden, exists only for FindName compatibility -->
        <Grid x:Name="Mover" Visibility="Collapsed" Height="0" />

        <!-- Caption Buttons (CaptionHeight=48 handles drag, these are exempt via IsHitTestVisibleInChrome) -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Height="48"
                    Orientation="Horizontal" Margin="0,0,16,0"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource MinimizeButton}" Click="Minimize" Margin="4,0" />
            <Button x:Name="NormalizeButton" Style="{StaticResource NormalizeButton}" Click="Normalize" Margin="4,0" />
            <Button x:Name="MaximizeButton" Style="{StaticResource MaximizeButton}" Click="Maximize" Margin="4,0" />
            <Button Style="{DynamicResource FluentCloseButton}" Content="&#xE8BB;" 
                    FontFamily="{DynamicResource FluentIconFont}" FontSize="10" Click="CloseWindow" Margin="4,0" />
        </StackPanel>

        <!-- ============================================================ -->
        <!-- Status Bar -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Background="{DynamicResource FluentTabBarBrush}" 
                BorderBrush="{DynamicResource FluentBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource NormalFont}" FontSize="11" 
                               Foreground="{DynamicResource FluentTextTertiaryBrush}" Text="{DynamicResource Lang.Window.Copyright}" />
                    <TextBlock FontFamily="{StaticResource NormalFont}" FontSize="11" 
                               Foreground="{DynamicResource FluentTextTertiaryBrush}" Margin="6,0,0,0" Text="·" />
                    <TextBlock FontFamily="{StaticResource NormalFont}" FontSize="11" 
                               Foreground="{DynamicResource FluentTextTertiaryBrush}" Margin="6,0,0,0" 
                               Text="Made with ♥ in Engelskirchen, Germany | upgrade by zzangae, Republic of Korea" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource NormalFont}" FontSize="11" 
                               Foreground="{DynamicResource FluentTextTertiaryBrush}" Text="{DynamicResource Lang.Window.Version}" />
                    <TextBlock x:Name="VersionLabel" FontFamily="{StaticResource NormalFont}" FontSize="11" 
                               Foreground="{DynamicResource FluentTextTertiaryBrush}" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- Fade Background Overlay (for modal dialogs) -->
        <!-- ============================================================ -->
        <Border x:Name="FadeBackground" Grid.RowSpan="2" Opacity="0" Visibility="Collapsed" 
                Background="#80000000" />
    </Grid>
</Window>
