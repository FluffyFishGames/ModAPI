<Window x:Class="ModAPI.Windows.SubWindows.GameIntegrityWarning"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="420"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource FluentBgBrush}"
            BorderBrush="{DynamicResource FluentAccentBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 타이틀 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="⚠"
                           FontSize="20"
                           Foreground="{DynamicResource FluentAccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <TextBlock FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource FluentTextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Text="{DynamicResource Lang.Windows.GameNoSignature.Title}"/>
            </StackPanel>

            <!-- 구분선 -->
            <Border Grid.Row="2" Height="1"
                    Background="{DynamicResource FluentAccentBrush}"
                    Opacity="0.4"/>

            <!-- 메시지 -->
            <TextBlock Grid.Row="4"
                       x:Name="MessageText"
                       Foreground="{DynamicResource FluentTextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       LineHeight="20"/>

            <!-- 버튼 -->
            <StackPanel Grid.Row="6" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Padding="16,8" FontSize="13"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,0,8,0"
                        Content="{DynamicResource Lang.Windows.GameNoSignature.Cancel}"
                        Click="Cancel_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource FluentCardBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource FluentTextPrimaryBrush}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="ContinueButton"
                        Padding="16,8" FontSize="13" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Content="{DynamicResource Lang.Windows.GameNoSignature.Continue}"
                        Click="Continue_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource FluentAccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="2">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
