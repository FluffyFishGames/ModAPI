<Window x:Class="MODAPI_LangTool.AddLanguageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Lang.LangTool.AddDialog.Title}"
        Width="460" Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 타이틀 -->
        <TextBlock Grid.Row="0"
                   Text="{DynamicResource Lang.LangTool.AddDialog.Title}"
                   FontSize="18" FontWeight="Bold" Foreground="#E0E0E0"/>

        <!-- 국가 선택 ComboBox -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="{DynamicResource Lang.LangTool.AddDialog.IsoCode}"
                       Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Lang.LangTool.AddDialog.IsoCodeHint}"
                       Foreground="#556688" FontSize="10" Margin="0,0,0,6"/>
            <ComboBox x:Name="CountryComboBox"
                      Height="34"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      IsTextSearchCaseSensitive="False"
                      StaysOpenOnEdit="True"
                      SelectionChanged="CountryComboBox_SelectionChanged">
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Background" Value="#16213E"/>
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Setter Property="BorderBrush" Value="#0F3460"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"/>
                                        <TextBox x:Name="PART_EditableTextBox"
                                                 Grid.Column="0"
                                                 Background="Transparent"
                                                 Foreground="#E0E0E0"
                                                 BorderThickness="0"
                                                 Padding="8,0"
                                                 VerticalAlignment="Center"
                                                 FontSize="{TemplateBinding FontSize}"
                                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                                 CaretBrush="#E0E0E0"/>
                                        <ToggleButton Grid.Column="1"
                                                      Background="Transparent"
                                                      BorderThickness="0"
                                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                      Focusable="False">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#E0E0E0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </ToggleButton>
                                        <Popup x:Name="PART_Popup"
                                               Placement="Bottom"
                                               IsOpen="{TemplateBinding IsDropDownOpen}"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               PopupAnimation="Slide">
                                            <Border Background="#16213E"
                                                    BorderBrush="#0F3460"
                                                    BorderThickness="1"
                                                    MinWidth="{TemplateBinding ActualWidth}"
                                                    MaxHeight="220">
                                                <ScrollViewer>
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.Style>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E0E0E0"/>
                        <Setter Property="Background" Value="#16213E"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#0F3460"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsUsed}" Value="True">
                                <Setter Property="Foreground" Value="#556688"/>
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- ISO 코드 (읽기전용 — ComboBox 선택 시 자동 입력) -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="ISO Code"
                       Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="IsoCodeBox"
                     Background="#111128" Foreground="#888888"
                     BorderBrush="#0F3460" BorderThickness="1"
                     Padding="8,6" FontSize="13" FontFamily="Consolas"
                     IsReadOnly="True"/>
        </StackPanel>

        <!-- 언어파일 코드 -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="{DynamicResource Lang.LangTool.AddDialog.LangCode}"
                       Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Lang.LangTool.AddDialog.LangCodeHint}"
                       Foreground="#556688" FontSize="10" Margin="0,0,0,4"/>
            <TextBox x:Name="LangCodeBox"
                     Background="#16213E" Foreground="#E0E0E0"
                     BorderBrush="#0F3460" BorderThickness="1"
                     Padding="8,6" FontSize="13" FontFamily="Consolas"
                     MaxLength="10"/>
        </StackPanel>

        <!-- 언어명 -->
        <StackPanel Grid.Row="8">
            <TextBlock Text="{DynamicResource Lang.LangTool.AddDialog.LangName}"
                       Foreground="#888888" FontSize="11" Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource Lang.LangTool.AddDialog.LangNameHint}"
                       Foreground="#556688" FontSize="10" Margin="0,0,0,4"/>
            <TextBox x:Name="LangNameBox"
                     Background="#16213E" Foreground="#E0E0E0"
                     BorderBrush="#0F3460" BorderThickness="1"
                     Padding="8,6" FontSize="13"
                     MaxLength="50"/>
        </StackPanel>

        <!-- 오류 메시지 -->
        <TextBlock Grid.Row="10" x:Name="ErrorText"
                   Foreground="#E94560" FontSize="11"
                   Visibility="Collapsed"/>

        <!-- 버튼 -->
        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Lang.LangTool.AddDialog.Cancel}"
                    Background="#333355" Foreground="#E0E0E0"
                    BorderThickness="0" Padding="16,8"
                    FontSize="13" Cursor="Hand"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Content="{DynamicResource Lang.LangTool.AddDialog.Add}"
                    Background="#E94560" Foreground="White"
                    BorderThickness="0" Padding="16,8"
                    FontSize="13" FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
